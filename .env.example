# URL base de la API del backend.
# Mientras el repositorio de infraestructura no esté listo, este valor no se usa
# (ver VITE_USE_MOCK), pero se deja definido para el cambio futuro.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Mientras el backend no esté disponible: usar datos simulados (mock) en el frontend.
# Cuando el backend real esté listo, cambiar a "false".
VITE_USE_MOCK=true